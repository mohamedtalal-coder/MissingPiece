# backend/.env.example
MONGO_URI="MongoDB connection string goes here"
PORT="5000"
JWT_SECRET=replace-this-with-any-long-random-string-for-now
STRIPE_SECRET_KEY=replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-secret
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret