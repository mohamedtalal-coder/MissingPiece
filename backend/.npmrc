# ioredis-mock@8.13.1 (latest, dev-only, used to mock Redis in
# requireAuth.test.ts) only supports ioredis@^5 as a peer, but this project
# runs ioredis@^6 in production. There is no newer ioredis-mock release yet.
# This does not affect runtime code — ioredis-mock is test-only.
# Remove this once ioredis-mock ships ^6 support.
legacy-peer-deps=true
